package com.brayan.tiktokoverlay;

import android.app.Activity;
import android.content.Intent;
import android.net.Uri;
import android.os.Bundle;
import android.provider.Settings;
import android.widget.Button;
import android.widget.EditText;
import android.widget.Toast;

public class MainActivity extends Activity {
    static final int REQ = 1;
    EditText etSaldo;

    @Override
    protected void onCreate(Bundle s) {
        super.onCreate(s);
        setContentView(R.layout.activity_main);
        etSaldo = findViewById(R.id.etSaldo);

        findViewById(R.id.btnAtivar).setOnClickListener(v -> {
            if (!Settings.canDrawOverlays(this)) {
                startActivityForResult(
                    new Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
                        Uri.parse("package:" + getPackageName())), REQ);
            } else {
                startOverlay();
            }
        });

        findViewById(R.id.btnDesativar).setOnClickListener(v -> {
            stopService(new Intent(this, OverlayService.class));
            Toast.makeText(this, "Overlay desativado", Toast.LENGTH_SHORT).show();
        });
    }

    @Override
    protected void onActivityResult(int req, int res, Intent data) {
        if (req == REQ && Settings.canDrawOverlays(this)) startOverlay();
    }

    void startOverlay() {
        String saldo = etSaldo.getText().toString().trim();
        if (saldo.isEmpty()) saldo = "999999";
        Intent i = new Intent(this, OverlayService.class);
        i.putExtra("saldo", saldo);
        startForegroundService(i);
        Toast.makeText(this, "Overlay ativado!", Toast.LENGTH_SHORT).show();
    }
}
