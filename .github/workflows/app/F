<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#141419">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🪙 Overlay Brayan"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/etSaldo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Saldo (ex: 999999)"
        android:inputType="number"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:backgroundTint="#555555"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnAtivar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ativar Overlay"
        android:backgroundTint="#FE2C55"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnDesativar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Desativar"
        android:backgroundTint="#303039"/>

</LinearLayout>
